# Stock Sentinel Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Application Settings
# =============================================================================
STOCK_SENTINEL_DEBUG=false
STOCK_SENTINEL_LOG_LEVEL=INFO

# =============================================================================
# Database Settings
# =============================================================================
# SQLite (default)
STOCK_SENTINEL_DATABASE_URL=sqlite+aiosqlite:///./stock_sentinel.db

# PostgreSQL (optional, for production)
# STOCK_SENTINEL_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/stock_sentinel

# =============================================================================
# Beeper API Settings (for SMS notifications)
# =============================================================================
# Get your API key from https://beeper.com/
STOCK_SENTINEL_BEEPER_API_URL=https://api.beeper.com/v1
STOCK_SENTINEL_BEEPER_API_KEY=your_beeper_api_key_here
STOCK_SENTINEL_BEEPER_SENDER_ID=+1234567890

# =============================================================================
# Webhook Server Settings
# =============================================================================
STOCK_SENTINEL_WEBHOOK_HOST=0.0.0.0
STOCK_SENTINEL_WEBHOOK_PORT=8080
STOCK_SENTINEL_WEBHOOK_SECRET=your_webhook_secret_here

# =============================================================================
# Stock Monitoring Settings
# =============================================================================
# Default symbols to watch (comma-separated in CLI, list in Python)
STOCK_SENTINEL_WATCHLIST=["AAPL", "GOOGL", "MSFT", "AMZN", "TSLA"]

# Check interval in minutes
STOCK_SENTINEL_CHECK_INTERVAL_MINUTES=15

# Only check during market hours (9:30 AM - 4:00 PM ET)
STOCK_SENTINEL_MARKET_HOURS_ONLY=true

# =============================================================================
# Alert Settings
# =============================================================================
# Minimum time between alerts for same stock/indicator (minutes)
STOCK_SENTINEL_COOLDOWN_MINUTES=60

# Maximum alerts per hour (to prevent spam)
STOCK_SENTINEL_MAX_ALERTS_PER_HOUR=10

# =============================================================================
# Indicator Thresholds
# =============================================================================
# RSI thresholds
STOCK_SENTINEL_RSI_OVERSOLD=30.0
STOCK_SENTINEL_RSI_OVERBOUGHT=70.0

# Volume spike multiplier (2.0 = volume must be 2x average)
STOCK_SENTINEL_VOLUME_SPIKE_MULTIPLIER=2.0

# Price change percentage threshold
STOCK_SENTINEL_PRICE_CHANGE_THRESHOLD=5.0
